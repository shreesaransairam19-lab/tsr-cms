# ============================================
# TSR CMS - Environment Variables
# Copy to .env.local and fill in your own values.
# NEVER commit .env.local (it is gitignored).
# ============================================

# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay - https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMS - MSG91 - https://control.msg91.com/
NEXT_PUBLIC_MSG91_API_KEY=
NEXT_PUBLIC_MSG91_SENDER_ID=

# Email - Gmail SMTP (use a 16-char App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WhatsApp
NEXT_PUBLIC_WHATSAPP_API_URL=
NEXT_PUBLIC_WHATSAPP_API_TOKEN=

# Google Sheets export
GOOGLE_SHEETS_CREDENTIALS=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COLLEGE_NAME=
NEXT_PUBLIC_COLLEGE_CODE=